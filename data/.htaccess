# Ochrana před přístupem k datům administrace přes URL zvenčí
# Zakazuje všem webovým klientům číst jakékoliv soubory v této složce (např. JSON databázi a hash hesla).
# PHP skripty tyto soubory stále mohou číst lokálně na serveru.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
